{
  "name": "zn-gate",
  "mcpName": "io.github.usezn/zn-gate",
  "version": "1.18.0",
  "description": "The local security layer for coding agents. zn-gate guards secrets, data and systems in Claude Code, Codex CLI, Cursor, OpenCode, Antigravity and ZCode desktop app, plus Gemini CLI and Copilot CLI (both experimental). No account, nothing sent by default.",
  "license": "MIT",
  "author": "usezn <admin@usezn.com>",
  "homepage": "https://usezn.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usezn/zn.git"
  },
  "bugs": {
    "url": "https://github.com/usezn/zn/issues"
  },
  "keywords": [
    "prompt-injection",
    "mcp",
    "model-context-protocol",
    "ai-security",
    "llm-guardrails",
    "ai-agents",
    "security-proxy",
    "cursor",
    "claude-code",
    "opencode",
    "antigravity",
    "zcode",
    "codex"
  ],
  "bin": {
    "zn-gate": "bin/cli.js",
    "zn-mcp": "bin/cli.js",
    "zn": "bin/cli.js"
  },
  "type": "commonjs",
  "main": "lib/client.js",
  "types": "lib/client.d.ts",
  "scripts": {
    "postinstall": "node lib/agents/refresh.js",
    "test": "node test/run-all.js",
    "check:rules": "node --test test/rules_snapshot.test.js"
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "DISCLOSURE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "age-encryption": "0.3.1"
  },
  "bundleDependencies": [
    "age-encryption"
  ],
  "devDependencies": {
    "c8": "12.0.0",
    "fast-check": "4.10.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
