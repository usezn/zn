      "path": "%USERPROFILE%\\.ssh\\id_rsa",
      "expect": "block"
    },
    {
      "kind": "var",
      "path": "$env:USERPROFILE\\.aws\\credentials",
      "expect": "block"
    },
    {
      "kind": "var",
      "path": "~example/.ssh/id_rsa",
      "expect": "block"
    },
    {
      "kind": "var",
      "path": "$PWD/.env",
      "expect": "block"
    },
    {
      "kind": "var",
      "path": "/root/.ssh/id_rsa",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "\"~/.ssh/id_rsa\"",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "'.env'",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "~/\".ssh\"/id_rsa",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "~/.ss''h/id_rsa",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": ".e\"n\"v",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "~/.ssh/id_\\rsa",
      "expect": "block"
    },
    {
      "kind": "quote",
      "path": "/etc/sha\"\"dow",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": ".env.",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": ".env ",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": "C:\\Users\\example\\project\\.env.",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": "C:\\Users\\example\\.ssh\\id_rsa.",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": "C:\\Users\\example\\.ssh\\id_rsa ",
      "expect": "block"
    },
    {
      "kind": "trail",
      "path": ".env::$DATA",
      "expect": "block"
    },
    {
      "kind": "short",
      "path": "C:\\PROGRA~1\\example\\.env",
      "expect": "block"
    }
  ]
}
