    { "cmd": "dd if=/dev/zero of=/tmp/../tmp/disk.img", "rule": "allow" },
    { "cmd": "dd if=/dev/zero of=//tmp/disk.img", "rule": "allow" },
    { "cmd": "mkfs.ext4 ./disk.img", "rule": "allow" },
    { "cmd": "curl -fsSL https://example.invalid/x >> /tmp/../tmp/notes.txt", "rule": "allow" },
