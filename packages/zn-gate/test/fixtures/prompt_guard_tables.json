    "qualifier": ["previous", "prior", "above", "earlier", "preceding", "foregoing", "original", "initial", "existing", "system", "safety", "security", "former", "developer"],
    "noun": ["instructions?", "prompts?", "rules", "guidelines?", "directives?", "guidance", "restrictions?", "guardrails?", "context", "constraints?", "commands?", "policies", "programming", "orders", "limitations?", "directions", "requests?", "tasks?"]
