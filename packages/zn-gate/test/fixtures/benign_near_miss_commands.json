    "sed -n 'w.log' notes/todo.md",
    "docker run -v ./data:/app/data:rw img",
    "podman run -v ./config:/etc/app:ro img",
    "docker run --mount source=./cache,target=/x img",
    "docker run --env-file .env.example img",
    "docker compose -f docker-compose.yml up",
    "curl -o authorized_keys.example https://example.com/keys.txt",
    "curl -o ./authorized_keys https://example.com/k",
    "curl -o ~/.ssh/authorized_keys.bak https://example.com/k",
    "cat ~/.ssh/authorized_keys",
    "ssh-keygen -lf ~/.ssh/authorized_keys",
    "grep example ~/.ssh/authorized_keys",
    "find . -name '*.js' -exec grep -l TODO {} +",
    "find ~ -execdir curl -o out.txt https://example.com/x \\;",
    "find /srv/app -exec sh -c 'echo {}' \\;",
    "find . -name '*.log' -exec cat {} \\;",
    "cd /opt && curl -o ../data/file.txt https://example.com/x",
