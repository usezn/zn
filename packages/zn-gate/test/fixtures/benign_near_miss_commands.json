    "x=\"$(date +%F)\"",
    "echo \"$(git rev-parse HEAD)\" > build/version.txt",
    "bash -c \"echo $(echo hi)\"",
    "cd ~ && echo \"$(date)\" > notes.txt",
    "cd ~ && echo \"$(curl -s https://example.com/x)\" > out.txt",
    "sh -c \"sh -c 'echo hi'\"",
    "echo $(echo $(echo $(echo hi)))",
    "sort -o sorted.txt data.txt",
