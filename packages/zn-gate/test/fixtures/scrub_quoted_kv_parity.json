{
  "comment": "{S} stands for the replacement of one secret: __ZN_SECRET_1__ in the Node.js scrubber, [REDACTED_SECRET] in the Python redact_secrets. Fake values only.",
  "cases": [
    {
      "name": "json password with spaces",
      "input": "{\"password\":\"abcdefgh ijk lmn\",\"n\":1}",
      "output": "{\"password\":\"{S}\",\"n\":1}"
    },
    {
      "name": "shell password with spaces keeps the tail",
      "input": "password=\"abcdefgh ijk lmn\" x",
      "output": "password=\"{S}\" x"
    },
    {
      "name": "export single quoted",
      "input": "export TOKEN='fake one two three' && run",
      "output": "export TOKEN='{S}' && run"
    },
    {
      "name": "json number",
      "input": "{\"token\":12345678}",
      "output": "{\"token\":\"{S}\"}"
    },
    {
      "name": "json number nested",
      "input": "{\"params\":{\"arguments\":{\"page_token\":123456789}}}",
      "output": "{\"params\":{\"arguments\":{\"page_token\":\"{S}\"}}}"
    },
    {
      "name": "json negative decimal",
      "input": "{ \"token\" : -12345678.5 , \"n\" : null }",
      "output": "{ \"token\" : \"{S}\" , \"n\" : null }"
    },
    {
      "name": "json exponent",
      "input": "{\"api_key\":1.2345678e10,\"b\":[1,2]}",
      "output": "{\"api_key\":\"{S}\",\"b\":[1,2]}"
    },
    {
      "name": "single quoted key number",
      "input": "{'token': 12345678}",
      "output": "{'token': '{S}'}"
    },
    {
      "name": "escaped quotes inside value",
      "input": "{\"api_key\":\"fake key \\\"with\\\" quotes and spaces\",\"n\":1}",
      "output": "{\"api_key\":\"{S}\",\"n\":1}"
    },
    {
      "name": "single quoted value, backslash is a character",
      "input": "password='fake pass\\ phrase here' ok",
      "output": "password='{S}' ok"
    },
    {
      "name": "shell word glued to more pieces",
      "input": "export password='fake pass phrase here''more' && run",
      "output": "export password='{S}' && run"
    },
    {
      "name": "yaml colon with quoted value",
      "input": "password: \"abcdefgh ijk lmn\"",
      "output": "password: \"{S}\""
    },
    {
      "name": "arrow separator",
      "input": "'secret' => 'abcdefgh ijk lmn',",
      "output": "'secret' => '{S}',"
    },
    {
      "name": "unquoted key number is left alone (equals)",
      "input": "token=12345678 next",
      "output": "token=12345678 next"
    },
    {
      "name": "unquoted key number is left alone (yaml)",
      "input": "password: 123456789012345",
      "output": "password: 123456789012345"
    },
    {
      "name": "short quoted value",
      "input": "{\"password\":\"a b c\",\"n\":1}",
      "output": "{\"password\":\"a b c\",\"n\":1}"
    },
    {
      "name": "placeholder words",
      "input": "{\"password\":\"your password here\"}",
      "output": "{\"password\":\"your password here\"}"
    },
    {
      "name": "template placeholder",
      "input": "{\"token\":\"${API TOKEN HERE}\"}",
      "output": "{\"token\":\"${API TOKEN HERE}\"}"
    },
    {
      "name": "bearer reference",
      "input": "token: \"Bearer ${TOKEN}\"",
      "output": "token: \"Bearer ${TOKEN}\""
    },
    {
      "name": "short number",
      "input": "{\"token\":1234567}",
      "output": "{\"token\":1234567}"
    },
    {
      "name": "mask number",
      "input": "{\"token\":00000000}",
      "output": "{\"token\":00000000}"
    },
    {
      "name": "repeated digit number",
      "input": "{\"token\":11111111}",
      "output": "{\"token\":11111111}"
    },
    {
      "name": "boolean, null, array",
      "input": "{\"token\":true,\"password\":null,\"api_key\":[1,2,3]}",
      "output": "{\"token\":true,\"password\":null,\"api_key\":[1,2,3]}"
    },
    {
      "name": "other keys",
      "input": "{\"password_hint\":\"choose a long phrase\",\"token_count\":123456789}",
      "output": "{\"password_hint\":\"choose a long phrase\",\"token_count\":123456789}"
    },
    {
      "name": "plural keys",
      "input": "{\"tokens\":123456789,\"max_tokens\":100000000}",
      "output": "{\"tokens\":123456789,\"max_tokens\":100000000}"
    },
    {
      "name": "no closing quote",
      "input": "password=\"unterminated value with spaces",
      "output": "password=\"unterminated value with spaces"
    },
    {
      "name": "assignment, double quotes, spaces around =",
      "input": "password = \"Winter2026demo\"",
      "output": "password = \"{S}\""
    },
    {
      "name": "assignment, single quotes, spaces around =",
      "input": "password = 'Winter2026demo'",
      "output": "password = '{S}'"
    },
    {
      "name": "assignment, no quotes, spaces around =",
      "input": "password = Winter2026demo",
      "output": "password = {S}"
    },
    {
      "name": "assignment, double quotes, no spaces",
      "input": "password=\"Winter2026demo\"",
      "output": "password=\"{S}\""
    },
    {
      "name": "assignment, no quotes, no spaces, keeps the text after it",
      "input": "password=Winter2026demo user=demo",
      "output": "password={S} user=demo"
    },
    {
      "name": "YAML value",
      "input": "password: Winter2026demo",
      "output": "password: {S}"
    },
    {
      "name": "YAML quoted value with a digit",
      "input": "password: \"winter-demo-2026\"",
      "output": "password: \"{S}\""
    },
    {
      "name": "quoted PIN under password",
      "input": "password = \"12345678\"",
      "output": "password = \"{S}\""
    },
    {
      "name": "JSON member",
      "input": "{\"password\": \"Winter2026demo\", \"user\": \"demo\"}",
      "output": "{\"password\": \"{S}\", \"user\": \"demo\"}"
    },
    {
      "name": "single quoted dict entry",
      "input": "{'password': 'Winter2026demo'}",
      "output": "{'password': '{S}'}"
    },
    {
      "name": "upper-case key, lower-case value with digits",
      "input": "PASSWORD = \"winterdemo99\"",
      "output": "PASSWORD = \"{S}\""
    },
    {
      "name": "prefixed key",
      "input": "db_password = \"Winter2026demo\"",
      "output": "db_password = \"{S}\""
    },
    {
      "name": "token with a digit",
      "input": "token = \"abcdefgh1234\"",
      "output": "token = \"{S}\""
    },
    {
      "name": "input call",
      "input": "password = input()",
      "output": "password = input()"
    },
    {
      "name": "environment lookup, Python",
      "input": "password = os.environ[\"DB_PASS\"]",
      "output": "password = os.environ[\"DB_PASS\"]"
    },
    {
      "name": "environment lookup, Node",
      "input": "password = process.env.DB_PASS",
      "output": "password = process.env.DB_PASS"
    },
    {
      "name": "empty string",
      "input": "password = \"\"",
      "output": "password = \"\""
    },
    {
      "name": "short value",
      "input": "password = \"short\"",
      "output": "password = \"short\""
    },
    {
      "name": "placeholder word",
      "input": "password = \"changeme\"",
      "output": "password = \"changeme\""
    },
    {
      "name": "reference in quotes",
      "input": "password = \"${DB_PASSWORD}\"",
      "output": "password = \"${DB_PASSWORD}\""
    },
    {
      "name": "URL in quotes",
      "input": "password = \"https://example.com/x\"",
      "output": "password = \"https://example.com/x\""
    },
    {
      "name": "other key, quoted",
      "input": "password_hint = \"winterdemo99\"",
      "output": "password_hint = \"winterdemo99\""
    },
    {
      "name": "lower-case slug",
      "input": "password = \"password_field\"",
      "output": "password = \"password_field\""
    },
    {
      "name": "attribute access",
      "input": "password = args.password",
      "output": "password = args.password"
    },
    {
      "name": "getpass call",
      "input": "password = getpass.getpass()",
      "output": "password = getpass.getpass()"
    },
    {
      "name": "index expression",
      "input": "password = request.form[\"password\"]",
      "output": "password = request.form[\"password\"]"
    },
    {
      "name": "type annotation",
      "input": "password: SecretStr",
      "output": "password: SecretStr"
    },
    {
      "name": "generic type annotation",
      "input": "password: Optional[str]",
      "output": "password: Optional[str]"
    },
    {
      "name": "constant name",
      "input": "password = DB_PASSWORD_2",
      "output": "password = DB_PASSWORD_2"
    },
    {
      "name": "plain word under token",
      "input": "token = \"abcdefgh\"",
      "output": "token = \"abcdefgh\""
    },
    {
      "name": "plain word under password (a translation)",
      "input": "'password' => 'Contrasena'",
      "output": "'password' => 'Contrasena'"
    },
    {
      "name": "quoted number under token",
      "input": "token = \"12345678\"",
      "output": "token = \"12345678\""
    },
    {
      "name": "all-zero id",
      "input": "{\"password\": \"00000000-0000-0000-0000-000000000000\"}",
      "output": "{\"password\": \"00000000-0000-0000-0000-000000000000\"}"
    },
    {
      "name": "prose word",
      "input": "password: required",
      "output": "password: required"
    },
    {
      "name": "slug under secret",
      "input": "secret: \"my-secret-name\"",
      "output": "secret: \"my-secret-name\""
    }
  ]
}
