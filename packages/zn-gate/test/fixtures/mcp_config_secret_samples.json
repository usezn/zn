{
 "description": "Samples for the MCP configuration secret check, shared by the Node.js and Python tests. {V} is an invented value put in at run time. expect: [line, kind, name] for each credential found (the name is a key, a flag without dashes or a URL parameter).",
 "cases": [
  {
   "name": "env values in a pretty-printed .mcp.json",
   "lines": [
    "{",
    "  \"mcpServers\": {",
    "    \"search\": {",
    "      \"command\": \"npx\",",
    "      \"env\": {",
    "        \"BRAVE_API_KEY\": \"{V}\",",
    "        \"NOTION_TOKEN\": \"{V}\",",
    "        \"DB_PASSWORD\": \"{V}\",",
    "        \"githubPersonalAccessToken\": \"{V}\",",
    "        \"LOG_LEVEL\": \"debug\",",
    "        \"MAX_TOKENS\": \"4096\",",
    "        \"AUTHOR\": \"someone-with-a-long-name\",",
    "        \"PUBLIC_KEY\": \"{V}\",",
    "        \"TOKEN_FILE\": \"/home/user/token.json\"",
    "      }",
    "    }",
    "  }",
    "}"
   ],
   "expect": [
    [
     6,
     "environment variable",
     "BRAVE_API_KEY"
    ],
    [
     7,
     "environment variable",
     "NOTION_TOKEN"
    ],
    [
     8,
     "environment variable",
     "DB_PASSWORD"
    ],
    [
     9,
     "setting",
     "githubPersonalAccessToken"
    ]
   ]
  },
  {
   "name": "headers of a remote server",
   "lines": [
    "{ \"mcpServers\": { \"remote\": {",
    "  \"url\": \"https://mcp.example.com/sse\",",
    "  \"headers\": {",
    "    \"Authorization\": \"Bearer {V}\",",
    "    \"X-Api-Key\": \"{V}\",",
    "    \"Cookie\": \"sid={V}\",",
    "    \"Authorization\": \"Basic {V}\",",
    "    \"Accept\": \"text/event-stream\",",
    "    \"X-Request-Id\": \"{V}\"",
    "  }",
    "} } }"
   ],
   "expect": [
    [
     4,
     "header",
     "Authorization"
    ],
    [
     5,
     "header",
     "X-Api-Key"
    ],
    [
     6,
     "header",
     "Cookie"
    ],
    [
     7,
     "header",
     "Authorization"
    ]
   ]
  },
  {
   "name": "credential flags in the arguments",
   "lines": [
    "{ \"mcpServers\": { \"s\": {",
    "  \"command\": \"npx\",",
    "  \"args\": [\"-y\", \"pkg@1.2.3\", \"--api-key={V}\", \"--port\", \"8080\"]",
    " },",
    " \"t\": {",
    "  \"args\": [\"--token\", \"{V}\", \"--verbose\"]",
    " },",
    " \"u\": {",
    "  \"args\": [",
    "    \"--password\",",
    "    // the value is on the next line",
    "",
    "    \"{V}\",",
    "    \"--header\",",
    "    \"Authorization: Bearer {V}\",",
    "    \"--client-secret\",",
    "    \"--debug\"",
    "  ]",
    " } } }"
   ],
   "expect": [
    [
     3,
     "argument",
     "api-key"
    ],
    [
     6,
     "argument",
     "token"
    ],
    [
     13,
     "argument",
     "password"
    ],
    [
     15,
     "header",
     "Authorization"
    ]
   ]
  },
  {
   "name": "keys in a URL",
   "lines": [
    "{ \"mcpServers\": {",
    "  \"a\": { \"url\": \"https://mcp.example.com/mcp?api_key={V}\" },",
    "  \"b\": { \"url\": \"https://mcp.example.com/mcp?format=json&token={V}&page=2\" },",
    "  \"c\": { \"url\": \"https://mcp.example.com/mcp?profile=default\" },",
    "  \"d\": { \"url\": \"https://mcp.example.com/mcp?api_key=${API_KEY}\" },",
    "  \"e\": { \"args\": [\"--url\", \"https://mcp.example.com/mcp?key={V}\"] }",
    "} }"
   ],
   "expect": [
    [
     2,
     "URL",
     "api_key"
    ],
    [
     3,
     "URL",
     "token"
    ],
    [
     6,
     "URL",
     "key"
    ]
   ]
  },
  {
   "name": "references and placeholders are not credentials",
   "lines": [
    "{ \"mcpServers\": { \"s\": { \"env\": {",
    "  \"A_API_KEY\": \"${A_API_KEY}\",",
    "  \"B_TOKEN\": \"__ZN_B_TOKEN__\",",
    "  \"C_SECRET\": \"${env:C_SECRET}\",",
    "  \"D_PASSWORD\": \"$D_PASSWORD\",",
    "  \"E_TOKEN\": \"%E_TOKEN%\",",
    "  \"F_TOKEN\": \"{{ f_token }}\",",
    "  \"G_TOKEN\": \"<your token here>\",",
    "  \"H_TOKEN\": \"Bearer ${H_TOKEN}\",",
    "  \"I_TOKEN\": \"${input:i_token}\",",
    "  \"J_TOKEN\": \"\",",
    "  \"K_TOKEN\": \"none\",",
    "  \"L_TOKEN\": \"[REDACTED_SECRET]\"",
    "} } } }"
   ],
   "expect": []
  },
  {
   "name": "TOML tables, inline tables and arrays",
   "lines": [
    "[mcp_servers.search]",
    "command = \"npx\"",
    "args = [\"-y\", \"pkg\", \"--token={V}\"]",
    "",
    "[mcp_servers.search.env]",
    "BRAVE_API_KEY = \"{V}\"",
    "LOG_LEVEL = \"debug\"",
    "REF_TOKEN = \"${REF_TOKEN}\"",
    "",
    "[mcp_servers.search.http_headers]",
    "Authorization = \"Bearer {V}\"",
    "X-Api-Key = '{V}'",
    "",
    "[mcp_servers.other]",
    "env = { SERVICE_SECRET = \"{V}\", MODE = \"fast\" }",
    "args = [",
    "  \"--api-key\",",
    "  \"{V}\",",
    "]"
   ],
   "expect": [
    [
     3,
     "argument",
     "token"
    ],
    [
     6,
     "environment variable",
     "BRAVE_API_KEY"
    ],
    [
     11,
     "header",
     "Authorization"
    ],
    [
     12,
     "header",
     "X-Api-Key"
    ],
    [
     15,
     "environment variable",
     "SERVICE_SECRET"
    ],
    [
     18,
     "argument",
     "api-key"
    ]
   ]
  },
  {
   "name": "JSON with comments and trailing commas",
   "lines": [
    "{",
    "  // servers",
    "  \"mcpServers\": {",
    "    \"s\": {",
    "      \"env\": { \"OPENAI_API_KEY\": \"{V}\", /* inline */ \"MODE\": \"fast\", },",
    "    },",
    "  },",
    "}"
   ],
   "expect": [
    [
     5,
     "environment variable",
     "OPENAI_API_KEY"
    ]
   ]
  },
  {
   "name": "a syntax error does not hide a credential",
   "lines": [
    "{ \"mcpServers\": { \"s\": { \"env\": {",
    "  \"BRAVE_API_KEY\": \"{V}\"",
    "  \"BROKEN\": ",
    "} } "
   ],
   "expect": [
    [
     2,
     "environment variable",
     "BRAVE_API_KEY"
    ]
   ]
  },
  {
   "name": "short or plain values are not credentials",
   "lines": [
    "{ \"env\": {",
    "  \"A_TOKEN\": \"abc\",",
    "  \"B_PASSWORD\": \"true\",",
    "  \"C_SECRET\": \"oauth\",",
    "  \"AUTH\": \"required\",",
    "  \"D_API_KEY\": \"/etc/keys/service.json\",",
    "  \"GOOGLE_APPLICATION_CREDENTIALS\": \"./credentials.json\"",
    "} }"
   ],
   "expect": []
  },
  {
   "name": "a password variable without a separator and a second credential on one line",
   "lines": [
    "{ \"mcpServers\": { \"pg\": { \"env\": {",
    "  \"PGPASSWORD\": \"{V}\",",
    "  \"A_API_KEY\": \"{V}\", \"B_TOKEN\": \"{V}\"",
    "} } } }"
   ],
   "expect": [
    [
     2,
     "environment variable",
     "PGPASSWORD"
    ],
    [
     3,
     "environment variable",
     "A_API_KEY"
    ],
    [
     3,
     "environment variable",
     "B_TOKEN"
    ]
   ]
  },
  {
   "name": "text that only starts with Bearer or Basic is not a header",
   "lines": [
    "{ \"mcpServers\": { \"s\": {",
    "  \"description\": \"Bearer tokens are passed in the header\",",
    "  \"note\": \"Basic usage example for the server\",",
    "  \"args\": [\"--header=Authorization: Bearer {V}\", \"--header=Accept: text/html\"],",
    "  \"headers\": { \"Authorization\": \"Bearer {V}\" }",
    "} } }"
   ],
   "expect": [
    [
     4,
     "header",
     "Authorization"
    ],
    [
     5,
     "header",
     "Authorization"
    ]
   ]
  }
 ]
}