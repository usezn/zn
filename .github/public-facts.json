        "file": "packages/zn-gate/server.json",
        "json": "version"
      },
      {
        "file": "packages/zn-gate/server.json",
        "json": "packages.0.version"
      },
      {
        "file": "packages/zn-gate-py/pyproject.toml",
        "regex": "^version = \"([^\"]+)\"",
        "python": true
      },
      {
        "file": "packages/zn-gate-py/src/zn_gate/__init__.py",
        "regex": "^__version__ = \"([^\"]+)\"",
        "python": true
      },
      {
        "file": ".pre-commit-hooks.yaml",
        "regex": "^  entry: npx --yes zn-gate@(\\S+) scan$"
      },
      {
        "file": ".pre-commit-hooks.yaml",
        "regex": "^  entry: npx --yes zn-gate@(\\S+) audit$"
      },
      {
        "file": "README.md",
