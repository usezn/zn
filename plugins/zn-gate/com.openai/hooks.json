{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"$PLUGIN_ROOT/scripts/zn-node.sh\" PreToolUse hook codex", "timeout": 30, "statusMessage": "zn: checking for secrets" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"$PLUGIN_ROOT/scripts/zn-node.sh\" PostToolUse hook codex", "timeout": 30, "statusMessage": "zn: checking for secrets" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/bin/sh \"$PLUGIN_ROOT/scripts/zn-node.sh\" UserPromptSubmit hook codex", "timeout": 30, "statusMessage": "zn: checking for secrets" }
        ]
      }
    ]
  }
}
