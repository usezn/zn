{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" PreToolUse",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" PermissionRequest",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" PostToolUse",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" SessionStart",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" SubagentStart",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/scripts/zn-hook.sh\" Stop",
            "timeout": 30,
            "statusMessage": "zn: checking for secrets"
          }
        ]
      }
    ]
  }
}
