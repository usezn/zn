// Changelog fragments follow the format in README.md: "### Section" headings with "- " bullets
// directly below, no blank line, as the assembler in .github/scripts/changelog.mjs expects, and
// plain-text URLs. The rules that would rewrite that format or the README's literal "- " example are off.
{
  "extends": "../.markdownlint.jsonc",
  "MD001": false,
  "MD022": false,
  "MD032": false,
  "MD034": false,
  "MD038": false
}
